# Copy to .env and fill in only what you want to enable.
# Every integration below is OFF or NOT CONFIGURED until you set it.

# --- Local LLM (free) -------------------------------------------------------
# auto = use Ollama when reachable, otherwise the built-in template writer
# ollama = require Ollama (falls back to templates with a warning)
# template = never call an LLM
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
LLM_TIMEOUT_SECONDS=180

# --- LinkedIn (official API only) -------------------------------------------
# Create an app at https://www.linkedin.com/developers/apps and add the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products.
# Add the redirect URL below to the app's Auth settings.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8765/integrations/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
# LinkedIn REST API version (YYYYMM). LinkedIn retires versions after ~12 months.
LINKEDIN_API_VERSION=202609
# Optional: post as a company page (needs w_organization_social / Community Management API approval)
LINKEDIN_AUTHOR_URN=

# Master switch. Even when true, every post still needs human approval in the dashboard.
PUBLISHING_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true

# --- Public data sources ------------------------------------------------------
HN_SOURCE_ENABLED=true
# SEC EDGAR requires a descriptive User-Agent with a contact email, e.g. "Acme Labs ops@acme.com"
SEC_USER_AGENT=
# Free key: https://api.census.gov/data/key_signup.html (market sizing by state)
CENSUS_API_KEY=

# --- Outbound email (replies to inbound inquiries only) ----------------------
OUTBOUND_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SENDER_NAME=
# CAN-SPAM requires a valid physical postal address in commercial email
COMPANY_POSTAL_ADDRESS=
UNSUBSCRIBE_EMAIL=

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# If set, POST /api/inbound requires header "X-Inbound-Token: <value>"
INBOUND_API_TOKEN=
# Host names the dashboard answers to (protects against DNS rebinding). Add your domain only behind an authenticating proxy.
ALLOWED_HOSTS=127.0.0.1,localhost,::1,[::1]
