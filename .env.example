# Copy to .env and fill in only what you want to enable.
# Every integration below is OFF or NOT CONFIGURED until you set it.

# --- Local LLM (free) -------------------------------------------------------
# auto = use Ollama when reachable, otherwise the built-in template writer
# ollama = require Ollama (falls back to templates with a warning)
# template = never call an LLM
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
LLM_TIMEOUT_SECONDS=180
# Start `ollama serve` automatically when the local server is down (local URL only).
OLLAMA_AUTOSTART=false
# Optional path to ollama.exe (default: %LOCALAPPDATA%\Programs\Ollama\ollama.exe)
OLLAMA_EXE=
# Windows desktop notification for new warning/error alerts
ALERT_TOAST=true
# Post images: auto = branded HTML/CSS designs rendered by your installed Edge/Chrome (falls back to the
# simple card), pillow = always the simple card. BROWSER_PATH is optional (found automatically).
IMAGE_RENDERER=auto
BROWSER_PATH=

# --- LinkedIn (official API only) -------------------------------------------
# Create an app at https://www.linkedin.com/developers/apps and add the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products.
# Add the redirect URL below to the app's Auth settings.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8765/integrations/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
# LinkedIn REST API version (YYYYMM). LinkedIn retires versions after ~12 months.
LINKEDIN_API_VERSION=202609
# Optional: post as a company page (needs w_organization_social / Community Management API approval)
LINKEDIN_AUTHOR_URN=

# LinkedIn leads (Lead Sync API): people who submit your Lead Gen Form ads or register for events your Company Page
# organizes. Use a SEPARATE developer app approved for the Lead Sync API (see docs/LINKEDIN_LEAD_SYNC.md). Off by default.
LINKEDIN_LEADS_ENABLED=false
LINKEDIN_LEADS_CLIENT_ID=
LINKEDIN_LEADS_CLIENT_SECRET=
LINKEDIN_LEADS_REDIRECT_URI=http://127.0.0.1:8765/integrations/linkedin-leads/callback
# Add r_ads when you run Lead Gen Form ads, so the ad accounts can be listed.
LINKEDIN_LEADS_SCOPES=r_marketing_leadgen_automation r_organization_admin
# true: fetch only LinkedIn test leads (Campaign Manager preview), stored as sample data - for the acceptance test.
LINKEDIN_LEADS_TEST_ONLY=false

# Master switch. Even when true, every post still needs human approval in the dashboard.
PUBLISHING_ENABLED=false
# true: every email needs a person's approval. false: in Hybrid or Automatic mode an email covered by an active
# campaign authorization may go out at send time (see the Automation Control page). Posts always need a person.
# `doctor` warns while this is false.
REQUIRE_HUMAN_APPROVAL=true

# --- Public data sources ------------------------------------------------------
HN_SOURCE_ENABLED=true
# SEC EDGAR requires a descriptive User-Agent with a contact email, e.g. "Acme Labs ops@acme.com"
SEC_USER_AGENT=
# Free key: https://api.census.gov/data/key_signup.html (market sizing by state)
CENSUS_API_KEY=

# --- Email: approved replies and B2B outreach (see docs/SALES_SETUP.md) ------
# Nothing is sent while this is false. Every email also needs a person's approval in the dashboard.
OUTBOUND_EMAIL_ENABLED=false
# Gmail / Google Workspace: smtp.gmail.com, port 587, your full address, and a Google app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SENDER_NAME=
# CAN-SPAM requires a valid physical postal address in commercial email
COMPANY_POSTAL_ADDRESS=
UNSUBSCRIBE_EMAIL=
# Controlled testing: when set, every email is delivered ONLY to these addresses (comma-separated),
# with "[TEST for <intended recipient>]" in the subject. Leave empty for live sending.
OUTBOUND_TEST_RECIPIENTS=

# --- Sales mailbox (read-only: replies, unsubscribes, bounces) ---------------
# Gmail: imap.gmail.com, port 993. Your own server (cPanel): mail.<your domain>. Username/password default to
# SMTP_USERNAME / SMTP_PASSWORD.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# related (default): keep only sales mail (replies to our emails, bounces, Calendly, known contacts and lead
# companies), for a mailbox you also use for other work. all: keep every email (a dedicated sales mailbox).
INBOX_SCOPE=related
# Booking link offered to interested prospects (Calendly). Empty: replies ask for times instead.
CALENDLY_URL=

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Sign-in required for every page and API. Create the account in a terminal: python -m aime user create --username <name>
DASHBOARD_AUTH=true
# POST /api/inbound is off until this is set; callers then send the header "X-Inbound-Token: <value>"
INBOUND_API_TOKEN=
# Host names the dashboard answers to (protects against DNS rebinding). Add your domain only behind an authenticating proxy.
ALLOWED_HOSTS=127.0.0.1,localhost,::1,[::1]

# --- Off-machine backup (optional) --------------------------------------------
# Folder for an encrypted daily copy, e.g. C:\Users\<you>\OneDrive\AIME-Backups. Empty = off.
BACKUP_OFFSITE_DIR=
# 12+ characters. Keep it in your password manager: without it the copies cannot be decrypted.
BACKUP_PASSPHRASE=
